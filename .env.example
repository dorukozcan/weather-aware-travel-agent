# Copy this file to ".env" and fill in your free API keys.
# The app runs WITHOUT any keys (demo mode); keys unlock the full LLM agent
# and live weather data.

# Free LLM inference - https://console.groq.com/keys
GROQ_API_KEY=

# Optional: live weather - https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Optional: override the Groq model if the default is ever deprecated.
# See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
